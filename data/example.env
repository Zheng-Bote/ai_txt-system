# LLM Provider API Keys & Endpoints
OLLAMA_API_KEY=<your_ollama_api_key>
OLLAMA_ENDPOINT=https://api.ollama.com/v1/chat

OPENROUTER_API_KEY=<your_openrouter_api_key>
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions

GROQ_API_KEY=<your_groq_api_key>
GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions

NVIDIA_API_KEY=<your_nvidia_api_key>
NVIDIA_ENDPOINT=https://integrate.api.nvidia.com/v1/chat/completions

# --- OLLAMA (Cloud Managed) ---
# Text / Reasoning
OLLAMA_LLM_01=gpt-oss:120b-cloud
OLLAMA_LLM_02=llama4:70b-cloud
OLLAMA_LLM_03=deepseek-v4-pro:cloud
# Coding
OLLAMA_LLM_04=qwen3-coder-next:cloud
OLLAMA_LLM_05=kimi-k2.6:cloud

# --- OPENROUTER (Free Tier) ---
# Text / General
OPENROUTER_LLM_01=google/gemini-2.0-flash-001:free
